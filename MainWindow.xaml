<Window
    x:Class="MultiFrameViewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MultiFrameViewer"
    Title="三境"
    Icon="assets/app-icon.png"
    Width="1500"
    Height="900"
    MinWidth="960"
    MinHeight="600"
    Background="#080A0D"
    WindowStyle="None"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    KeyDown="OnWindowKeyDown">
    <Grid x:Name="RootGrid">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="打开全部三个画面" Click="OnChooseAllClick"/>
                <MenuItem Header="打开一个总文件夹（三画面共用）" Click="OnChooseSharedFolderClick"/>
                <MenuItem Header="显示 / 隐藏上下控制栏" Click="OnToggleChromeClick"/>
                <MenuItem
                    x:Name="HideCursorMenuItem"
                    Header="播放时自动隐藏鼠标"
                    IsCheckable="True"
                    IsChecked="True"
                    Click="OnToggleHideCursorClick"/>
                <MenuItem Header="每张 3 秒" Tag="3" Click="OnSetIntervalMenuClick"/>
                <MenuItem Header="每张 5 秒" Tag="5" Click="OnSetIntervalMenuClick"/>
                <MenuItem Header="每张 10 秒" Tag="10" Click="OnSetIntervalMenuClick"/>
                <MenuItem Header="每张 30 秒" Tag="30" Click="OnSetIntervalMenuClick"/>
                <Separator/>
                <MenuItem Header="最小化" Click="OnMinimizeClick"/>
                <MenuItem Header="退出" Click="OnCloseClick"/>
            </ContextMenu>
        </Grid.ContextMenu>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="42"/>
            <RowDefinition x:Name="MainRow" Height="*"/>
            <RowDefinition x:Name="FooterRow" Height="34"/>
        </Grid.RowDefinitions>

        <Border
            x:Name="TitleBar"
            Grid.Row="0"
            Panel.ZIndex="20"
            Background="#11151B"
            BorderBrush="#242B35"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="#F2F4F7"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="三境"/>
                <TextBlock
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="#8D97A6"
                    FontSize="11"
                    Text="右键画面选文件夹 · 双击画面单屏 · F10 隐藏上下边框 · Esc 返回"/>
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <Button
                        Width="34"
                        Height="30"
                        Margin="0,0,4,0"
                        Click="OnChooseAllClick"
                        ToolTip="依次为三个画面选择文件夹"
                        Content="…"
                        FontSize="18"/>
                    <Button
                        Width="34"
                        Height="30"
                        Margin="0,0,4,0"
                        Click="OnFullscreenClick"
                        ToolTip="最大化/还原窗口"
                        Content="□"
                        FontSize="16"/>
                    <Button
                        Width="34"
                        Height="30"
                        Margin="0,0,8,0"
                        Click="OnPresentationModeClick"
                        ToolTip="无边框放映；按 Esc 退出"
                        Content="▣"
                        FontSize="14"/>
                    <Button
                        Width="34"
                        Height="30"
                        Margin="0,0,4,0"
                        Click="OnMinimizeClick"
                        ToolTip="最小化"
                        Content="—"
                        FontSize="14"/>
                    <Button
                        Width="34"
                        Height="30"
                        Click="OnCloseClick"
                        ToolTip="关闭"
                        Content="×"
                        FontSize="18"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid
            x:Name="ContentGrid"
            Grid.Row="0"
            Grid.RowSpan="3"
            Background="#080A0D">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="*"/>
                <ColumnDefinition x:Name="Splitter1Column" Width="7"/>
                <ColumnDefinition x:Name="MiddleColumn" Width="*"/>
                <ColumnDefinition x:Name="Splitter2Column" Width="7"/>
                <ColumnDefinition x:Name="RightColumn" Width="*"/>
            </Grid.ColumnDefinitions>

            <local:SlideshowPanel x:Name="Panel1" Grid.Column="0"/>
            <GridSplitter
                x:Name="Splitter1"
                Grid.Column="1"
                Width="7"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext"
                Background="#1B212A"
                ShowsPreview="False"/>
            <local:SlideshowPanel x:Name="Panel2" Grid.Column="2"/>
            <GridSplitter
                x:Name="Splitter2"
                Grid.Column="3"
                Width="7"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext"
                Background="#1B212A"
                ShowsPreview="False"/>
            <local:SlideshowPanel x:Name="Panel3" Grid.Column="4"/>
        </Grid>

        <Border
            x:Name="FooterBar"
            Grid.Row="2"
            Panel.ZIndex="20"
            Background="#11151B"
            BorderBrush="#242B35"
            BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="#8D97A6"
                    FontSize="11"
                    Text="顺序：文件夹名 → 文件名 · 自动跨子文件夹循环"/>
                <TextBlock
                    Grid.Column="1"
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="#687382"
                    FontSize="11"
                    Text="右键换文件夹 · 拖分隔线调宽度 · 双击画面单屏"/>
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <TextBlock
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        Foreground="#8D97A6"
                        FontSize="11"
                        Text="每张"/>
                    <TextBox
                        x:Name="IntervalBox"
                        Width="44"
                        Height="23"
                        Padding="4,0"
                        Text="5"
                        TextAlignment="Center"
                        ToolTip="幻灯片停留秒数，最小 1 秒"
                        TextChanged="OnIntervalChanged"/>
                    <TextBlock
                        VerticalAlignment="Center"
                        Margin="6,0,14,0"
                        Foreground="#8D97A6"
                        FontSize="11"
                        Text="秒"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
